# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in ONE provider. The agent also runs with
# no key at all (`python run.py --mode offline`), so reviewers are never blocked.
# ---------------------------------------------------------------------------

# Which backend to use: groq | openai | anthropic | ollama
LLM_PROVIDER=groq

# Groq -- free tier, get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI -- https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic -- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Ollama -- fully local, no key. Requires `ollama serve` running.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
